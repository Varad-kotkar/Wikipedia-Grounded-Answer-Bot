# WikiTruth AI — Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ── LLM Provider (optional — app works without these using local Flan-T5) ────
# LLM_PROVIDER=anthropic   # or: openai, local
# ANTHROPIC_API_KEY=sk-ant-...  # get from: https://console.anthropic.com/
# OPENAI_API_KEY=sk-...         # get from: https://platform.openai.com/

# ── Embedding provider (default: sentence-transformers, no key needed) ───────
# EMBEDDING_PROVIDER=sentence-transformers

# ── Image generation (optional — improves image quality, free tier available) ─
# HF_TOKEN=hf_...               # get from: https://huggingface.co/settings/tokens

# ── Streamlit (optional overrides) ───────────────────────────────────────────
# STREAMLIT_SERVER_PORT=8501
